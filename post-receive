#!/bin/sh
#
# post-receive - one-file push-to-deploy for the ~/deploy layout.
#
# Install (per host, from the desktop):
#   ssh HOST 'cat > ~/deploy/post-receive &&
#             chmod 755 ~/deploy/post-receive' < post-receive
# then per app, symlink the repo's hook at that one file:
#   ssh HOST 'ln -sfn ../../../post-receive ~/deploy/repos/APP/hooks/post-receive'
# deploy.sh init does both. Every repo shares the file, so shipping a hook
# update is overwriting ~/deploy/post-receive once.
#
# Layout it owns:
#   ~/deploy/post-receive         this hook; repos symlink their hook to it
#   ~/deploy/repos/<app>          bare repo (the push target)
#   ~/deploy/live/<app>!<hash>    one release dir per commit
#   ~/deploy/live/<app>!CURRENT   symlink -> the deployed release
#   ~/deploy/shared/<app>/env     optional environment file; unit + deploy commands
#   ~/deploy/shared/<app>/deploy.conf   optional command overrides (see below)
#
# Commands are detected from the tree: pnpm-lock.yaml -> pnpm install/build/start;
# uv.lock -> uv sync + .venv/bin/python main.py. Anything else goes in deploy.conf:
#   SYNC="..."  AFTER_SYNC="..."  BUILD="..."  EXEC="..."  UNIT_ENV="A=1 B=2"
#
# SYNC, AFTER_SYNC and BUILD run through `sh -e -c` in the release dir, so they
# are shell snippets: "uv run scripts/seed.py; pnpm build" runs both, and the
# first failure stops the deploy. EXEC is an ExecStart= line and gets no shell -
# one process, full paths (the unit's PATH has ~/.local/bin and /usr/bin).
#
# The unit is regenerated whenever its content changes, so editing deploy.conf
# and re-pushing is enough - never hand-edit the unit.
set -eu

# post-receive cannot fail a push (only pre-receive/update can), so a failure
# has to shout in the push output - and must never leave a half-made release.
die() {
    echo "post-receive: DEPLOY FAILED: $1" >&2
    # A failed deploy was never activated and nothing points at it, so it would
    # only sit in live/ forever. Keep it only while it is CURRENT (re-pushing
    # the deployed commit).
    if [ -n "${LIVE_DIR:-}" ] && [ -d "$LIVE_DIR" ] \
        && [ "$LIVE_DIR" != "${CURRENT_TARGET:-}" ]; then
        rm -rf "$LIVE_DIR"
    fi
    exit 1
}

# --- where -------------------------------------------------------------------
REPO_DIR=$(git rev-parse --absolute-git-dir)
REPO_NAME=$(basename "$REPO_DIR")
SERVICE_NAME=${REPO_NAME%.git}
# Only pushes to this branch deploy; DEPLOY_REF overrides it server-side.
DEPLOY_REF=${DEPLOY_REF:-refs/heads/master}

DEPLOY_ROOT=$(cd "$REPO_DIR/../.." && pwd)
LIVE_ROOT="${DEPLOY_ROOT}/live"
SHARED_DIR="${DEPLOY_ROOT}/shared/${REPO_NAME}"
SHARED_ENV="${SHARED_DIR}/env"
SHARED_CONF="${SHARED_DIR}/deploy.conf"
UNIT_FILE="${HOME}/.config/systemd/user/${SERVICE_NAME}.service"

# --- which commit (stdin carries "<old> <new> <ref>" per updated ref) --------
DEPLOY_REV=""
while read -r _old new ref; do
    [ "$ref" = "$DEPLOY_REF" ] || continue
    # All-zero new rev means the branch was deleted: nothing to deploy.
    case "$new" in 0000000000000000000000000000000000000000) continue ;; esac
    DEPLOY_REV=$new
done

if [ -z "$DEPLOY_REV" ]; then
    echo "post-receive: no update to ${DEPLOY_REF}, nothing to deploy."
    exit 0
fi

HASH=$(git rev-parse --short "$DEPLOY_REV")
LIVE_DIR="${LIVE_ROOT}/${REPO_NAME}!${HASH}"
LIVE_DIR_CURR="${LIVE_ROOT}/${REPO_NAME}!CURRENT"

# --- tools (push shells are non-interactive, so resolve absolutely) ----------
if ! UV=$(command -v uv 2>/dev/null); then UV="${HOME}/.local/bin/uv"; fi
if ! NODE=$(command -v node 2>/dev/null); then NODE=/usr/bin/node; fi
if ! PNPM=$(command -v pnpm 2>/dev/null); then PNPM=/usr/local/bin/pnpm; fi
if ! command -v systemctl >/dev/null 2>&1; then
    die "systemctl not found; this hook assumes a systemd user session."
fi

# env is optional: an app with no configuration deploys without it. The
# unit also carries the '-' prefix on EnvironmentFile=, so systemd starts it
# whether or not the file exists - and picks it up once one does.
if [ ! -f "$SHARED_ENV" ]; then
    echo "post-receive: note: ${SHARED_ENV} is missing - deploying without it."
fi

# The deploy-time commands get the same variables the unit does, or a seed
# script connects as the server's OS user with no password ("password
# authentication failed for user <server user>") instead of the app's role.
#
# The file is a systemd EnvironmentFile, not a shell script: its values are
# taken literally (deploy.sh writes `KEY=value`, double-quoted when the value
# needs it). Sourcing it would expand a `$` inside a password or JWT secret.
load_env() { # $1 path
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in '' | '#'* | ';'*) continue ;; esac
        case $line in *=*) ;; *) continue ;; esac
        key=${line%%=*}
        # systemd allows nothing but a plain name here; anything else is a
        # hand-edited line that systemd would reject too, so skip it.
        case $key in [A-Za-z_]*) ;; *) continue ;; esac
        case $key in *[!A-Za-z0-9_]*) continue ;; esac
        val=${line#*=}
        case $val in
            \"*\")
                val=${val#\"}
                val=${val%\"}
                # undo the double-quoting encode_value applies: \\ -> \, \" -> "
                unq=""
                while [ -n "$val" ]; do
                    c=${val%"${val#?}"}
                    val=${val#?}
                    if [ "$c" = '\' ] && [ -n "$val" ]; then
                        c=${val%"${val#?}"}
                        val=${val#?}
                    fi
                    unq=$unq$c
                done
                val=$unq
                ;;
            \'*\')
                val=${val#\'}
                val=${val%\'}
                ;;
        esac
        export "$key=$val"
    done < "$1"
}

if [ -f "$SHARED_ENV" ]; then
    load_env "$SHARED_ENV"
fi

mkdir -p "$LIVE_ROOT"

CURRENT_TARGET=""
if [ -L "$LIVE_DIR_CURR" ]; then
    CURRENT_TARGET=$(readlink -f "$LIVE_DIR_CURR")
fi

# Clear the wreckage of earlier failed pushes before building: those releases
# were never activated, so nothing but this loop will ever remove them. Runs on
# every push, so a run of failures cannot pile up dirs for this repo.
for dir in "$LIVE_ROOT/${REPO_NAME}"!*; do
    case $dir in *"!CURRENT") continue ;; esac
    if [ ! -d "$dir" ]; then continue; fi
    if [ "$dir" = "$LIVE_DIR" ] || [ "$dir" = "$CURRENT_TARGET" ]; then continue; fi
    echo "Removing stale release $(basename "$dir")..."
    rm -rf "$dir"
done

# Re-pushing the deployed commit reuses its release dir, and checkout -f leaves
# files that commit deleted. Clear it first - never while it is CURRENT.
if [ "$LIVE_DIR" != "$CURRENT_TARGET" ]; then
    rm -rf "$LIVE_DIR"
fi
mkdir -p "$LIVE_DIR"

echo "Checking out ${HASH}..."
git --work-tree="$LIVE_DIR" checkout -f "$DEPLOY_REV" -- .

# --- detect the app ----------------------------------------------------------
RUNTIME=""
SYNC=""
BUILD=""
EXEC=""
UNIT_ENV=""
AFTER_SYNC=""

if [ -f "$LIVE_DIR/pnpm-lock.yaml" ]; then
    RUNTIME=node
    if [ ! -x "$NODE" ]; then
        die "node not found on PATH or at /usr/bin (the app runs via pnpm start)."
    fi
    SYNC="${PNPM} install --frozen-lockfile"
    if grep -q '"build"[[:space:]]*:' "$LIVE_DIR/package.json" 2>/dev/null; then
        BUILD="${PNPM} build"
    fi
    EXEC="${PNPM} start"
    UNIT_ENV="NODE_ENV=production"
elif [ -f "$LIVE_DIR/uv.lock" ]; then
    RUNTIME=python
    SYNC="${UV} sync --locked --no-dev"
    if [ -f "$LIVE_DIR/main.py" ]; then
        EXEC="${LIVE_DIR_CURR}/.venv/bin/python main.py"
    fi
    UNIT_ENV="PYTHONUNBUFFERED=1"
else
    die "no uv.lock or pnpm-lock.yaml at ${HASH} - set SYNC and EXEC in
              ${SHARED_CONF} if this is intentional."
fi

# Optional per-repo overrides win over detection. Check the syntax first so a
# broken deploy.conf reads as a deploy failure naming the file, instead of a
# bare `set -e` exit from the dot command.
if [ -f "$SHARED_CONF" ]; then
    if ! CONF_ERR=$(sh -n "$SHARED_CONF" 2>&1); then
        die "syntax error in ${SHARED_CONF}: ${CONF_ERR}"
    fi
    # shellcheck disable=SC1090
    . "$SHARED_CONF" || die "could not source ${SHARED_CONF}"
fi

# {repo} {hash} {root} {live} {live_curr} {shared} expand in commands and env,
# so a deploy.conf can name paths without hardcoding this server's layout.
expand() {
    sed -e "s|{repo}|${REPO_NAME}|g" \
        -e "s|{hash}|${HASH}|g" \
        -e "s|{root}|${DEPLOY_ROOT}|g" \
        -e "s|{live}|${LIVE_DIR}|g" \
        -e "s|{live_curr}|${LIVE_DIR_CURR}|g" \
        -e "s|{shared}|${SHARED_DIR}|g"
}

SYNC=$(printf '%s' "$SYNC" | expand)
EXEC=$(printf '%s' "$EXEC" | expand)
if [ -n "${BUILD:-}" ]; then BUILD=$(printf '%s' "$BUILD" | expand); fi
if [ -n "${AFTER_SYNC:-}" ]; then AFTER_SYNC=$(printf '%s' "$AFTER_SYNC" | expand); fi
if [ -n "${UNIT_ENV:-}" ]; then UNIT_ENV=$(printf '%s' "$UNIT_ENV" | expand); fi

for var in SYNC EXEC; do
    eval "value=\${$var:-}"
    if [ -z "$value" ]; then
        die "${var} is empty for this app - set it in ${SHARED_CONF}."
    fi
done

# deploy.conf commands are shell snippets, so they get a shell: expanding them
# unquoted would leave a ';' glued to the first word ("Failed to spawn:
# scripts/seed.py;") instead of separating two commands. -e stops at the first
# failure, so "a; b" fails the deploy when a does.
run_cmd() { # label, command
    if ! sh -e -c "$2"; then
        die "$1 failed: $2"
    fi
}

cd "$LIVE_DIR"
echo "Syncing deps (${RUNTIME})..."
run_cmd sync "$SYNC"
if [ -n "${AFTER_SYNC:-}" ]; then
    run_cmd AFTER_SYNC "$AFTER_SYNC"
fi
if [ -n "${BUILD:-}" ]; then
    echo "Building..."
    run_cmd build "$BUILD"
fi

# --- systemd user units (regenerated when they differ) -----------------------
# The main unit runs EXEC. Optional extra processes come from deploy.conf:
#   PROCS="worker beat"
#   EXEC_worker="{live_curr}/.venv/bin/python -m myapp.worker"
# Each becomes <app>-<name>.service, PartOf the main unit, so a restart of the
# main unit (which every deploy does) restarts them too.
UNIT_DIR="${HOME}/.config/systemd/user"
UNIT_EXTRA=""
for line in ${UNIT_ENV:-}; do
    UNIT_EXTRA="${UNIT_EXTRA}Environment=${line}
"
done

write_unit() { # $1 unit name, $2 description, $3 ExecStart, $4 extra [Unit] lines
    _file="${UNIT_DIR}/$1.service"
    _xu=""
    if [ -n "${4:-}" ]; then _xu="$4
"; fi
    _body="# Generated by post-receive - edit ${SHARED_CONF}, not this file.
[Unit]
Description=$2
After=network.target
${_xu}[Service]
Type=simple
WorkingDirectory=${LIVE_DIR_CURR}
ExecStart=$3
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-${SHARED_ENV}
${UNIT_EXTRA}[Install]
WantedBy=default.target
"
    _new=0
    if [ ! -f "$_file" ]; then
        _new=1
    fi
    # Both sides go through command substitution so the comparison ignores a
    # trailing newline; otherwise every deploy would look like a change.
    if [ "$_new" = 1 ] || [ "$(cat "$_file" 2>/dev/null)" != "$(printf '%s' "$_body")" ]; then
        echo "Installing $1.service..."
        mkdir -p "$UNIT_DIR"
        printf '%s' "$_body" > "$_file"
        systemctl --user daemon-reload
        if [ "$_new" = 1 ]; then
            systemctl --user enable "$1.service"
        fi
    fi
}

write_unit "$SERVICE_NAME" "$SERVICE_NAME" "$EXEC" ""

PROC_MARK="# proc-of: ${SERVICE_NAME}"
PROC_UNITS=""
for p in ${PROCS:-}; do
    case $p in
        *[!A-Za-z0-9_]*) die "bad process name '${p}' in PROCS (letters, digits, _ only)." ;;
    esac
    eval "cmd=\${EXEC_$p:-}"
    if [ -z "$cmd" ]; then die "EXEC_${p} is empty - set it in ${SHARED_CONF}."; fi
    cmd=$(printf '%s' "$cmd" | expand)
    unit="${SERVICE_NAME}-${p}"
    # Another app can be called <app>-<name>; never overwrite its unit.
    if [ -f "${UNIT_DIR}/${unit}.service" ] \
        && ! grep -qxF "$PROC_MARK" "${UNIT_DIR}/${unit}.service"; then
        die "${UNIT_DIR}/${unit}.service exists and was not generated for ${SERVICE_NAME}."
    fi
    write_unit "$unit" "${SERVICE_NAME} ${p}" "$cmd" "${PROC_MARK}
PartOf=${SERVICE_NAME}.service"
    PROC_UNITS="${PROC_UNITS} ${unit}"
done

# A process dropped from PROCS: stop, disable and remove its unit. Only files
# carrying this app's marker are touched.
for f in "${UNIT_DIR}"/*.service; do
    if [ ! -f "$f" ]; then continue; fi
    grep -qxF "$PROC_MARK" "$f" || continue
    u=$(basename "$f" .service)
    case " ${PROC_UNITS} " in *" ${u} "*) continue ;; esac
    echo "Removing stale ${u}.service..."
    systemctl --user disable --now "${u}.service" || true
    rm -f "$f"
    systemctl --user daemon-reload
done

# --- activate -----------------------------------------------------------------
echo "Linking CURRENT -> ${HASH}..."
cd "$LIVE_ROOT"
ln -sfn "$(basename "$LIVE_DIR")" "$(basename "$LIVE_DIR_CURR")"

echo "Restarting ${SERVICE_NAME}..."
systemctl --user restart "${SERVICE_NAME}.service"
# PartOf restarts the extra units that are already running; start covers new ones.
for u in ${PROC_UNITS}; do
    systemctl --user start "${u}.service"
done

# Every other release dir for this repo is either the one just replaced or the
# wreckage of a deploy that died before it was activated - neither is reachable
# through CURRENT, so both go now that the new release is serving.
for dir in "$LIVE_ROOT/${REPO_NAME}"!*; do
    case "$dir" in *"!CURRENT") continue ;; esac
    if [ ! -d "$dir" ]; then continue; fi
    if [ "$dir" = "$LIVE_DIR" ]; then continue; fi
    echo "Removing stale release $(basename "$dir")..."
    rm -rf "$dir"
done

echo "Deployed ${REPO_NAME} ${HASH}."
